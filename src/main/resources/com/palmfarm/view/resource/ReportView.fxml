<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane style="-fx-background-color:#1a2a1a;" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.palmfarm.controller.resource.ReportViewController">
  <center>
    <VBox spacing="10" style="-fx-padding:24 40;">
      <Label style="-fx-text-fill:#4CAF50;-fx-font-size:20px;-fx-font-weight:bold;" text="ออกรายงาน" />
      <Label style="-fx-text-fill:#aaccaa;-fx-font-size:12px;" wrapText="true" />
      <Label style="-fx-text-fill:#4CAF50;-fx-font-weight:bold;-fx-padding:8 0 0 0;" text="งานและการจัดสรร" />
      <Button maxWidth="Infinity" onAction="#handleExportWorkOrder" style="-fx-background-color:#243224;-fx-text-fill:#ccddcc;-fx-font-size:14px;-fx-cursor:hand;-fx-padding:12 20;-fx-background-radius:8;-fx-alignment:CENTER_LEFT;" text="รายงานใบสั่งงานล่าสุด" />
      <Button maxWidth="Infinity" onAction="#handleExportAllocation" style="-fx-background-color:#243224;-fx-text-fill:#ccddcc;-fx-font-size:14px;-fx-cursor:hand;-fx-padding:12 20;-fx-background-radius:8;-fx-alignment:CENTER_LEFT;" text="รายงานการจัดสรรทรัพยากร" />
      <Button maxWidth="Infinity" onAction="#handleExportResponsible" style="-fx-background-color:#243224;-fx-text-fill:#ccddcc;-fx-font-size:14px;-fx-cursor:hand;-fx-padding:12 20;-fx-background-radius:8;-fx-alignment:CENTER_LEFT;" text="รายงานผู้รับผิดชอบงานและทรัพยากร" />
      <Label style="-fx-text-fill:#4CAF50;-fx-font-weight:bold;-fx-padding:8 0 0 0;" text="ทรัพยากร" />
      <Button maxWidth="Infinity" onAction="#handleExportVehicle" style="-fx-background-color:#243224;-fx-text-fill:#ccddcc;-fx-font-size:14px;-fx-cursor:hand;-fx-padding:12 20;-fx-background-radius:8;-fx-alignment:CENTER_LEFT;" text="รายชื่อรถ" />
      <Button maxWidth="Infinity" onAction="#handleExportEquip" style="-fx-background-color:#243224;-fx-text-fill:#ccddcc;-fx-font-size:14px;-fx-cursor:hand;-fx-padding:12 20;-fx-background-radius:8;-fx-alignment:CENTER_LEFT;" text="รายชื่ออุปกรณ์" />
      <Label style="-fx-text-fill:#4CAF50;-fx-font-weight:bold;-fx-padding:8 0 0 0;" text="ข้อมูลหลัก" />
      <Button maxWidth="Infinity" onAction="#handleExportPlantation" style="-fx-background-color:#243224;-fx-text-fill:#ccddcc;-fx-font-size:14px;-fx-cursor:hand;-fx-padding:12 20;-fx-background-radius:8;-fx-alignment:CENTER_LEFT;" text="รายชื่อแปลงสวนปาล์ม" />
      <Button maxWidth="Infinity" onAction="#handleExportEmployee" style="-fx-background-color:#243224;-fx-text-fill:#ccddcc;-fx-font-size:14px;-fx-cursor:hand;-fx-padding:12 20;-fx-background-radius:8;-fx-alignment:CENTER_LEFT;" text="รายชื่อพนักงาน" />
      <Label style="-fx-text-fill:#4CAF50;-fx-font-weight:bold;-fx-padding:8 0 0 0;" text="บัญชี" />
      <Button maxWidth="Infinity" onAction="#handleExportBill" style="-fx-background-color:#243224;-fx-text-fill:#ccddcc;-fx-font-size:14px;-fx-cursor:hand;-fx-padding:12 20;-fx-background-radius:8;-fx-alignment:CENTER_LEFT;" text="รายงานบิลการขายผลผลิต" />
      <Label fx:id="lblMsg" style="-fx-font-size:12px;" text="" wrapText="true" />
    </VBox>
  </center>
</BorderPane>
