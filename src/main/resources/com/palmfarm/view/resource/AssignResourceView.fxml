<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.palmfarm.controller.resource.AssignResourceViewController"
            style="-fx-background-color:#1a2a1a;">
  <center>
    <VBox spacing="10" style="-fx-padding:15;">

      <!-- Task selector row -->
      <HBox alignment="CENTER_LEFT" spacing="12"
            style="-fx-background-color:#243224;-fx-padding:12;-fx-background-radius:6;">
        <Label text="Task:" style="-fx-text-fill:#ccddcc;-fx-font-weight:bold;"/>
        <ComboBox fx:id="cbTask" prefWidth="420"/>
        <VBox spacing="2">
          <Label fx:id="lblTaskPlantation" text="สวน: —"
                 style="-fx-text-fill:#88cc88;-fx-font-size:12px;"/>
          <Label fx:id="lblTaskDeadline"   text="กำหนดส่ง: —"
                 style="-fx-text-fill:#aaccaa;-fx-font-size:12px;"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="รีเฟรช" onAction="#handleRefresh"
                style="-fx-background-color:#607D8B;-fx-text-fill:white;-fx-cursor:hand;"/>
      </HBox>

      <!-- Main content: resource table (left) + reservation list (right) -->
      <HBox spacing="12" VBox.vgrow="ALWAYS">

        <!-- ซ้าย: ตารางทรัพยากร + checkbox -->
        <VBox spacing="6" HBox.hgrow="ALWAYS">
          <HBox alignment="CENTER_LEFT" spacing="10">
            <Label text="ทรัพยากรที่พร้อมใช้งาน (เลือกได้หลายรายการ):"
                   style="-fx-text-fill:#aaccaa;-fx-font-weight:bold;"/>
            <Button text="จัดสรรที่เลือกทั้งหมด" onAction="#handleAssign"
                    style="-fx-background-color:#FF9800;-fx-text-fill:white;
                           -fx-cursor:hand;-fx-font-weight:bold;-fx-padding:6 14;"/>
          </HBox>
          <TableView fx:id="tableResource" VBox.vgrow="ALWAYS" editable="true"
                     style="-fx-background-color:#243224;-fx-control-inner-background:#243224;">
            <columns>
              <TableColumn fx:id="colCheck"     text="เลือก"  prefWidth="60"  editable="true"/>
              <TableColumn fx:id="colResId"     text="ID"     prefWidth="55"/>
              <TableColumn fx:id="colResName"   text="ชื่อ"    prefWidth="230"/>
              <TableColumn fx:id="colResType"   text="ประเภท"  prefWidth="110"/>
              <TableColumn fx:id="colResStatus" text="สถานะ"   prefWidth="100"/>
            </columns>
            <placeholder>
              <Label text="ไม่มีทรัพยากรที่พร้อมใช้งาน" style="-fx-text-fill:#88aa88;"/>
            </placeholder>
          </TableView>
          <Label fx:id="lblMsg" text="" style="-fx-font-size:12px;" wrapText="true"/>
        </VBox>

        <!-- ขวา: รายการที่จัดสรรให้ task นี้แล้ว -->
        <VBox spacing="6" prefWidth="340">
          <Label text="ทรัพยากรที่จัดสรรให้ Task นี้แล้ว:"
                 style="-fx-text-fill:#aaccaa;-fx-font-weight:bold;"/>
          <TableView fx:id="tableReservation" VBox.vgrow="ALWAYS"
                     style="-fx-background-color:#243224;-fx-control-inner-background:#243224;">
            <columns>
              <TableColumn fx:id="colRlResource" text="ทรัพยากร" prefWidth="145"/>
              <TableColumn fx:id="colRlType"     text="ประเภท"   prefWidth="90"/>
              <TableColumn fx:id="colRlDate"     text="วันที่"    prefWidth="105"/>
              <TableColumn fx:id="colRlStatus"   text="สถานะ"    prefWidth="90"/>
            </columns>
            <placeholder>
              <Label text="เลือก Task เพื่อดูรายการ" style="-fx-text-fill:#88aa88;"/>
            </placeholder>
          </TableView>
        </VBox>

      </HBox>
    </VBox>
  </center>
</BorderPane>
