<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane style="-fx-background-color: #1a2a1a;" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.palmfarm.controller.resource.SchedulingViewController">
    <center>
        <VBox spacing="8" style="-fx-padding: 15;">

            <HBox alignment="CENTER_LEFT" spacing="8">
                <Label style="-fx-text-fill: #aaccaa; -fx-font-weight: bold;" text="งานทั้งหมดที่ยังไม่เสร็จสิ้น:" />
                <Region HBox.hgrow="ALWAYS" />
                <Button fx:id="btnRefresh" onAction="#handleRefresh" style="-fx-background-color: #2196F3; -fx-text-fill: white;                                -fx-cursor: hand; -fx-padding: 5 12;" text="รีเฟรช" />
            </HBox>

            <TableView fx:id="tableTask" style="-fx-background-color: #243224; -fx-control-inner-background: #243224;" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colId" prefWidth="55" text="ID" />
                    <TableColumn fx:id="colDesc" prefWidth="250" text="คำอธิบาย" />
                    <TableColumn fx:id="colPlantation" prefWidth="120" text="สวนปาล์ม" />
                    <TableColumn fx:id="colDept" prefWidth="110" text="ฝ่าย" />
                    <TableColumn fx:id="colComplete" prefWidth="145" text="สถานะการดำเนินงาน" />
                    <TableColumn fx:id="colOrdered" prefWidth="145" text="สถานะการมอบหมาย" />
                    <TableColumn fx:id="colDeadline" prefWidth="110" text="กำหนดส่ง" />
                    <TableColumn fx:id="colAction" prefWidth="90" text="เลื่อน" />
                </columns>
                <placeholder>
                    <Label style="-fx-text-fill: #88aa88;" text="ไม่มีงานที่ยังไม่เสร็จ" />
                </placeholder>
            </TableView>

            <Label fx:id="lblMsg" style="-fx-font-size: 12px;" text="" wrapText="true" />

        </VBox>
    </center>
</BorderPane>
