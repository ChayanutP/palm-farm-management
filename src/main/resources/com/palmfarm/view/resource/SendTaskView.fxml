<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane style="-fx-background-color: #1a2a1a;" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.palmfarm.controller.resource.SendTaskViewController">
    <center>
        <VBox spacing="8" style="-fx-padding: 15;">

            <HBox alignment="CENTER_LEFT" spacing="8">
                <Label style="-fx-text-fill: #aaccaa; -fx-font-weight: bold; -fx-font-size: 13px;" text="ใบสั่งงานที่ยังไม่ได้มอบหมาย:" />
            </HBox>

            <TableView fx:id="tableTask" style="-fx-background-color: #243224; -fx-control-inner-background: #243224;" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colTaskId" prefWidth="55" text="ID" />
                    <TableColumn fx:id="colTaskDesc" prefWidth="240" text="คำอธิบาย" />
                    <TableColumn fx:id="colTaskPlantation" prefWidth="130" text="สวนปาล์ม" />
                    <TableColumn fx:id="colTaskDept" prefWidth="130" text="ฝ่าย" />
                    <TableColumn fx:id="colTaskOrdered" prefWidth="145" text="สถานะการมอบหมาย" />
                    <TableColumn fx:id="colTaskDeadline" prefWidth="115" text="กำหนดส่ง" />
                    <TableColumn fx:id="colTaskDate" prefWidth="115" text="วันที่สร้าง" />
                </columns>
                <placeholder>
                    <Label style="-fx-text-fill: #88aa88;" text="ไม่มีใบสั่งงานที่ยังไม่ได้มอบหมาย" />
                </placeholder>
            <columnResizePolicy>
               <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
            </TableView>

            <HBox alignment="CENTER_LEFT" spacing="10">
                <Button fx:id="btnSend" disable="true" onAction="#handleSendTask" style="-fx-background-color: #4CAF50; -fx-text-fill: white;                                -fx-font-size: 13px; -fx-font-weight: bold;                                -fx-cursor: hand; -fx-padding: 8 20; -fx-background-radius: 6;" text="มอบหมายงาน" />
                <Label fx:id="lblMsg" style="-fx-font-size: 12px;" text="" wrapText="true" />
            </HBox>

        </VBox>
    </center>
</BorderPane>
