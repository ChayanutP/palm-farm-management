<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.palmfarm.controller.resource.SendTaskViewController"
            style="-fx-background-color: #1a2a1a;">

    <!-- MAIN CONTENT -->
    <center>
        <HBox spacing="15" style="-fx-padding: 15;">

            <!-- ซ้าย: ตาราง task ที่ยังไม่ส่ง -->
            <VBox spacing="8" HBox.hgrow="ALWAYS">

                <HBox spacing="8" alignment="CENTER_LEFT">
                    <Label text="ใบสั่งงานที่ยังไม่ได้ส่ง:"
                           style="-fx-text-fill: #aaccaa; -fx-font-weight: bold; -fx-font-size: 13px;"/>
                    <Button text="รีเฟรช" onAction="#handleRefresh"
                            style="-fx-background-color: #2196F3; -fx-text-fill: white;
                                   -fx-cursor: hand; -fx-padding: 5 12;"/>
                </HBox>

                <TableView fx:id="tableTask" VBox.vgrow="ALWAYS"
                           style="-fx-background-color: #243224;
                                  -fx-control-inner-background: #243224;">
                    <columns>
                        <TableColumn fx:id="colTaskId"      text="ID"         prefWidth="55"/>
                        <TableColumn fx:id="colTaskDesc"    text="คำอธิบาย"    prefWidth="260"/>
                        <TableColumn fx:id="colTaskDept"    text="ฝ่าย"        prefWidth="120"/>
                        <TableColumn fx:id="colTaskOrdered" text="สถานะส่ง"    prefWidth="105"/>
                        <TableColumn fx:id="colTaskDeadline" text="กำหนดส่ง"  prefWidth="115"/>
                        <TableColumn fx:id="colTaskDate"    text="วันสร้าง"    prefWidth="115"/>
                    </columns>
                    <placeholder>
                        <Label text="ไม่มีใบสั่งงานที่รอส่ง"
                               style="-fx-text-fill: #88aa88;"/>
                    </placeholder>
                </TableView>

            </VBox>

            <!-- ขวา: panel รายละเอียด + ปุ่มส่ง -->
            <VBox spacing="12" prefWidth="270"
                  style="-fx-background-color: #243224; -fx-padding: 20;
                         -fx-background-radius: 8;">

                <Label text="รายละเอียดงานที่เลือก"
                       style="-fx-text-fill: #4CAF50; -fx-font-weight: bold;
                              -fx-font-size: 14px;"/>

                <Separator style="-fx-background-color: #3a5a3a;"/>

                <Label fx:id="lblDetailId"
                       style="-fx-text-fill: #88cc88; -fx-font-size: 12px;"/>
                <Label fx:id="lblDetailDesc" wrapText="true"
                       style="-fx-text-fill: #ddeedd; -fx-font-size: 13px;
                              -fx-font-weight: bold;"/>
                <Label fx:id="lblDetailDept"
                       style="-fx-text-fill: #aaccaa; -fx-font-size: 12px;"/>
                <Label fx:id="lblDetailDeadline"
                       style="-fx-text-fill: #aaccaa; -fx-font-size: 12px;"/>

                <Separator style="-fx-background-color: #3a5a3a;"/>

                <Label fx:id="lblDetailStatus"
                       style="-fx-text-fill: #aaccaa; -fx-font-size: 12px;"/>
                <Label fx:id="lblDetailOrdered"
                       style="-fx-text-fill: #FFD700; -fx-font-size: 12px;
                              -fx-font-weight: bold;"/>

                <Region VBox.vgrow="ALWAYS"/>

                <Button fx:id="btnSend"
                        text="ส่งงาน" onAction="#handleSendTask"
                        maxWidth="Infinity"
                        style="-fx-background-color: #4CAF50; -fx-text-fill: white;
                               -fx-font-size: 14px; -fx-font-weight: bold;
                               -fx-cursor: hand; -fx-padding: 10;
                               -fx-background-radius: 6;"/>

                <Label fx:id="lblMsg" text="" wrapText="true"
                       style="-fx-text-fill: #88ff88; -fx-font-size: 12px;"/>

            </VBox>

        </HBox>
    </center>

</BorderPane>
