<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.palmfarm.controller.resource.SendTaskViewController"
            style="-fx-background-color: #1a2a1a;">
    <center>
        <VBox spacing="8" style="-fx-padding: 15;">

            <HBox alignment="CENTER_LEFT" spacing="8">
                <Label text="ใบสั่งงานที่ยังไม่ได้มอบหมาย:"
                       style="-fx-text-fill: #aaccaa; -fx-font-weight: bold; -fx-font-size: 13px;"/>
                <Button text="รีเฟรช" onAction="#handleRefresh"
                        style="-fx-background-color: #2196F3; -fx-text-fill: white;
                               -fx-cursor: hand; -fx-padding: 5 12;"/>
            </HBox>

            <TableView fx:id="tableTask" VBox.vgrow="ALWAYS"
                       style="-fx-background-color: #243224; -fx-control-inner-background: #243224;">
                <columns>
                    <TableColumn fx:id="colTaskId"          text="ID"               prefWidth="55"/>
                    <TableColumn fx:id="colTaskDesc"         text="คำอธิบาย"         prefWidth="240"/>
                    <TableColumn fx:id="colTaskPlantation"   text="สวนปาล์ม"         prefWidth="130"/>
                    <TableColumn fx:id="colTaskDept"         text="ฝ่าย"              prefWidth="130"/>
                    <TableColumn fx:id="colTaskOrdered"      text="สถานะการมอบหมาย"  prefWidth="145"/>
                    <TableColumn fx:id="colTaskDeadline"     text="กำหนดส่ง"          prefWidth="115"/>
                    <TableColumn fx:id="colTaskDate"         text="วันที่สร้าง"        prefWidth="115"/>
                </columns>
                <placeholder>
                    <Label text="ไม่มีใบสั่งงานที่ยังไม่ได้มอบหมาย"
                           style="-fx-text-fill: #88aa88;"/>
                </placeholder>
            </TableView>

            <HBox spacing="10" alignment="CENTER_LEFT">
                <Button fx:id="btnSend" text="มอบหมายงาน"
                        onAction="#handleSendTask" disable="true"
                        style="-fx-background-color: #4CAF50; -fx-text-fill: white;
                               -fx-font-size: 13px; -fx-font-weight: bold;
                               -fx-cursor: hand; -fx-padding: 8 20; -fx-background-radius: 6;"/>
                <Label fx:id="lblMsg" text="" wrapText="true"
                       style="-fx-font-size: 12px;"/>
            </HBox>

        </VBox>
    </center>
</BorderPane>
