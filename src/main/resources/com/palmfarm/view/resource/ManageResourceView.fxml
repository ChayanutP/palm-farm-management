<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.palmfarm.controller.resource.ManageResourceViewController"
            style="-fx-background-color:#1a2a1a;">
  <center>
    <VBox spacing="10" style="-fx-padding:15;">
      <HBox spacing="8" alignment="CENTER_LEFT">
        <Label text="รายการทรัพยากรทั้งหมด:"
               style="-fx-text-fill:#aaccaa;-fx-font-weight:bold;"/>
        <Button text="รีเฟรช" onAction="#handleRefresh"
                style="-fx-background-color:#2196F3;-fx-text-fill:white;
                       -fx-cursor:hand;-fx-padding:5 12;"/>
      </HBox>
      <TableView fx:id="tableResource" VBox.vgrow="ALWAYS"
                 style="-fx-background-color:#243224;-fx-control-inner-background:#243224;">
        <columns>
          <TableColumn fx:id="colResId"     text="ID"      prefWidth="60"/>
          <TableColumn fx:id="colResName"   text="ชื่อ"     prefWidth="300"/>
          <TableColumn fx:id="colResType"   text="ประเภท"   prefWidth="130"/>
          <TableColumn fx:id="colResStatus" text="สถานะ"    prefWidth="130"/>
        </columns>
        <placeholder>
          <Label text="ไม่มีข้อมูลทรัพยากร" style="-fx-text-fill:#88aa88;"/>
        </placeholder>
      </TableView>
    </VBox>
  </center>
</BorderPane>
