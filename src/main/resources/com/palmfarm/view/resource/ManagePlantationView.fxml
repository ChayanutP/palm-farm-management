<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane style="-fx-background-color:#1a2a1a;" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.palmfarm.controller.resource.ManagePlantationViewController">
  <center>
    <HBox spacing="12" style="-fx-padding:12;">
      <VBox spacing="6" HBox.hgrow="ALWAYS">
        <HBox alignment="CENTER_LEFT" spacing="8">
          <Label style="-fx-text-fill:#aaccaa;-fx-font-weight:bold;" text="รายชื่อสวนปาล์ม:" />
          <Button onAction="#handleRefresh" style="-fx-background-color: #2196F3; -fx-text-fill: white; -fx-cursor: hand; -fx-padding: 5 12;" text="รีเฟรช" />
        </HBox>
        <TableView fx:id="tablePlantation" style="-fx-background-color:#243224;-fx-control-inner-background:#243224;" VBox.vgrow="ALWAYS">
          <columns>
            <TableColumn fx:id="colId" prefWidth="60" text="ID" />
            <TableColumn fx:id="colName" prefWidth="180" text="ชื่อสวน" />
            <TableColumn fx:id="colArea" prefWidth="120" text="พื้นที่" />
            <TableColumn fx:id="colLocation" prefWidth="220" text="ที่ตั้ง" />
          </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
        </TableView>
      </VBox>
      <VBox prefWidth="260" spacing="6" style="-fx-background-color:#243224;-fx-padding:12;-fx-background-radius:8;">
        <Label style="-fx-text-fill:#4CAF50;-fx-font-weight:bold;-fx-font-size:14px;" text="ข้อมูลสวนปาล์ม" />
        <Separator />
        <Label style="-fx-text-fill:#ccddcc;" text="ชื่อสวน:" />
        <TextField fx:id="txtName" style="-fx-background-color:#2d3e2d;-fx-text-fill:white;" />
        <Label style="-fx-text-fill:#ccddcc;" text="พื้นที่ (ไร่):" />
        <TextField fx:id="txtArea" style="-fx-background-color:#2d3e2d;-fx-text-fill:white;" />
        <Label style="-fx-text-fill:#ccddcc;" text="ที่ตั้ง:" />
        <TextField fx:id="txtLocation" style="-fx-background-color:#2d3e2d;-fx-text-fill:white;" />
        <Separator />
        <HBox spacing="8">
          <Button maxWidth="Infinity" onAction="#handleAdd" style="-fx-background-color:#4CAF50;-fx-text-fill:white;-fx-cursor:hand;-fx-padding:8;-fx-background-radius:5;" text="เพิ่มสวน" HBox.hgrow="ALWAYS" />
          <Button maxWidth="Infinity" onAction="#handleUpdate" style="-fx-background-color:#FF9800;-fx-text-fill:white;-fx-cursor:hand;-fx-padding:8;-fx-background-radius:5;" text="แก้ไข" HBox.hgrow="ALWAYS" />
          <Button onAction="#handleExport" prefHeight="34.0" prefWidth="58.0" style="-fx-background-color: #795548; -fx-text-fill: white; -fx-cursor: hand; -fx-padding: 5 12;" text="Export" />
        </HBox>
        <Label fx:id="lblMsg" style="-fx-font-size:12px;" text="" wrapText="true" />
      </VBox>
    </HBox>
  </center>
</BorderPane>
