<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane style="-fx-background-color:#1a2a1a;" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.palmfarm.controller.resource.CreateTaskViewController">
  <center>
    <VBox spacing="10" style="-fx-padding:15;">

      <!-- Form row -->
      <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-background-color:#243224;-fx-padding:12;-fx-background-radius:6;">
        <Label style="-fx-text-fill:#ccddcc;" text="คำอธิบาย:" />
        <TextField fx:id="txtDescription" prefWidth="220" promptText="รายละเอียดงาน" style="-fx-background-color:#2d3e2d;-fx-text-fill:white;" />
        <Label style="-fx-text-fill:#ccddcc;" text="สวนปาล์ม:" />
        <ComboBox fx:id="cbPlantation" prefWidth="185" promptText="เลือกสวน" />
        <Label style="-fx-text-fill:#ccddcc;" text="ฝ่าย:" />
        <ComboBox fx:id="cbDept" prefWidth="145" promptText="เลือกฝ่าย" />
        <Label style="-fx-text-fill:#ccddcc;" text="กำหนดส่ง:" />
        <DatePicker fx:id="dpDeadline" prefWidth="148" />
        <Button onAction="#handleCreateTask" style="-fx-background-color:#4CAF50;-fx-text-fill:white;-fx-cursor:hand;-fx-padding:6 14;" text=" สร้างใบสั่งงาน" />
        <Button onAction="#handleRefresh" style="-fx-background-color:#2196F3;-fx-text-fill:white;-fx-cursor:hand;" text="" />
      </HBox>

      <Label fx:id="lblMsg" style="-fx-font-size:12px;" text="" />

      <!-- Task table -->
      <TableView fx:id="tableTask" style="-fx-background-color:#243224;-fx-control-inner-background:#243224;" VBox.vgrow="ALWAYS">
        <columns>
          <TableColumn fx:id="colId" prefWidth="55" text="ID" />
          <TableColumn fx:id="colDesc" prefWidth="250" text="คำอธิบาย" />
          <TableColumn fx:id="colPlantation" prefWidth="140" text="สวนปาล์ม" />
          <TableColumn fx:id="colDept" prefWidth="120" text="ฝ่าย" />
          <TableColumn fx:id="colStatus" prefWidth="141.60003662109375" text="สถานะการดำเนินงาน" />
          <TableColumn fx:id="colOrdered" prefWidth="148.0" text="สถานะการมอบหมาย" />
          <TableColumn fx:id="colDeadline" prefWidth="240.00006103515625" text="กำหนดส่ง" />
        </columns>
        <placeholder><Label style="-fx-text-fill:#88aa88;" text="ไม่มีข้อมูล" /></placeholder>
      </TableView>
    </VBox>
  </center>
</BorderPane>
