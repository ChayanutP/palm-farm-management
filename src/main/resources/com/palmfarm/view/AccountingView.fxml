<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.palmfarm.controller.AccountingViewController"
            style="-fx-background-color: #1a2a1a;">
    <center>
        <TabPane fx:id="tabPane" tabClosingPolicy="UNAVAILABLE"
                 style="-fx-background-color: #1a2a1a; -fx-tab-min-width: 220px;">

            <!-- UC16: จัดเก็บบิล -->
            <Tab text="จัดเก็บบิล (UC16)">
                <HBox spacing="15" style="-fx-padding: 15;">
                    <VBox spacing="10" HBox.hgrow="ALWAYS">
                        <HBox spacing="8">
                            <Button text="อัปโหลดรูปบิล" onAction="#handleUploadBill"
                                    style="-fx-background-color: #2196F3; -fx-text-fill: white; -fx-cursor: hand;"/>
                            <Button text="จัดเก็บบิลที่เลือก" onAction="#handleStoreBill"
                                    style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-cursor: hand;"/>
                            <Button text="รีเฟรช" onAction="#handleRefresh"
                                    style="-fx-background-color: #607D8B; -fx-text-fill: white; -fx-cursor: hand;"/>
                        </HBox>
                        <Label fx:id="lblStoreMsg" text="" style="-fx-text-fill: #88ff88;"/>
                        <TableView fx:id="tableUnstored" VBox.vgrow="ALWAYS"
                                   style="-fx-background-color: #243224; -fx-control-inner-background: #243224;">
                            <columns>
                                <TableColumn fx:id="colUsBillId"   text="ID"       prefWidth="70"/>
                                <TableColumn fx:id="colUsUploaded" text="อัปโหลดเมื่อ" prefWidth="200"/>
                                <TableColumn fx:id="colUsStored"   text="จัดเก็บแล้ว" prefWidth="110"/>
                            </columns>
                            <placeholder><Label text="ไม่มีบิลที่รอจัดเก็บ" style="-fx-text-fill: #88aa88;"/></placeholder>
                        </TableView>
                    </VBox>
                    <!-- Preview -->
                    <VBox spacing="8" prefWidth="300" style="-fx-background-color: #243224; -fx-padding: 10; -fx-background-radius: 8;">
                        <Label text="ตัวอย่างรูปบิล" style="-fx-text-fill: #aaccaa; -fx-font-weight: bold;"/>
                        <ImageView fx:id="imgBillPreview" fitWidth="280" fitHeight="350" preserveRatio="true"/>
                    </VBox>
                </HBox>
            </Tab>

            <!-- UC17: บันทึกข้อมูลบิล -->
            <Tab text="บันทึกข้อมูลบิล (UC17)">
                <HBox spacing="15" style="-fx-padding: 15;">
                    <!-- Table -->
                    <VBox spacing="8" HBox.hgrow="ALWAYS">
                        <Label text="บิลที่จัดเก็บแล้ว (รอกรอกข้อมูล):" style="-fx-text-fill: #aaccaa; -fx-font-weight: bold;"/>
                        <TableView fx:id="tableStored" VBox.vgrow="ALWAYS"
                                   style="-fx-background-color: #243224; -fx-control-inner-background: #243224;">
                            <columns>
                                <TableColumn fx:id="colStBillId" text="ID"        prefWidth="60"/>
                                <TableColumn fx:id="colStNumber" text="เลขที่บิล"   prefWidth="140"/>
                                <TableColumn fx:id="colStDate"   text="วันที่ขาย"   prefWidth="120"/>
                                <TableColumn fx:id="colStBuyer"  text="ผู้รับซื้อ"   prefWidth="160"/>
                                <TableColumn fx:id="colStTotal"  text="ยอดรวม (฿)" prefWidth="120"/>
                            </columns>
                            <placeholder><Label text="ไม่มีบิล" style="-fx-text-fill: #88aa88;"/></placeholder>
                        </TableView>
                        <!-- Image -->
                        <Label text="รูปบิลที่เลือก:" style="-fx-text-fill: #aaccaa;"/>
                        <ImageView fx:id="imgStoredBill" fitWidth="400" fitHeight="200" preserveRatio="true"/>
                    </VBox>
                    <!-- Form -->
                    <VBox spacing="8" prefWidth="300"
                          style="-fx-background-color: #243224; -fx-padding: 15; -fx-background-radius: 8;">
                        <Label text="กรอกข้อมูลบิล" style="-fx-text-fill: #4CAF50; -fx-font-weight: bold; -fx-font-size: 14px;"/>
                        <Label text="เลขที่บิล:" style="-fx-text-fill: #ccddcc;"/>
                        <TextField fx:id="txtBillNumber" promptText="เลขที่บิล"
                                   style="-fx-background-color: #2d3e2d; -fx-text-fill: white;"/>
                        <Label text="วันที่ขาย:" style="-fx-text-fill: #ccddcc;"/>
                        <DatePicker fx:id="dpSaleDate" prefWidth="260"/>
                        <Label text="ผู้รับซื้อ:" style="-fx-text-fill: #ccddcc;"/>
                        <TextField fx:id="txtBuyer" promptText="ชื่อผู้รับซื้อ"
                                   style="-fx-background-color: #2d3e2d; -fx-text-fill: white;"/>
                        <Label text="ปริมาณปาล์ม (กก.):" style="-fx-text-fill: #ccddcc;"/>
                        <TextField fx:id="txtQuantity" promptText="ปริมาณ"
                                   style="-fx-background-color: #2d3e2d; -fx-text-fill: white;"/>
                        <Label text="ราคาต่อหน่วย (฿/กก.):" style="-fx-text-fill: #ccddcc;"/>
                        <TextField fx:id="txtPriceUnit" promptText="ราคา"
                                   style="-fx-background-color: #2d3e2d; -fx-text-fill: white;"/>
                        <Label fx:id="lblTotalCalc" text="รวม: —"
                               style="-fx-text-fill: #FFD700; -fx-font-size: 14px; -fx-font-weight: bold;"/>
                        <Button text="บันทึกข้อมูลบิล" onAction="#handleSaveBillData" maxWidth="Infinity"
                                style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-cursor: hand; -fx-padding: 8;"/>
                        <Label fx:id="lblDataMsg" text="" style="-fx-text-fill: #88ff88;" wrapText="true"/>
                    </VBox>
                </HBox>
            </Tab>

        </TabPane>
    </center>
</BorderPane>
