<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.palmfarm.controller.quality.RecordInspectionViewController"
            style="-fx-background-color:#1a2a1a;">
  <center>
    <HBox spacing="15" style="-fx-padding:15;">
      <VBox spacing="8" prefWidth="290"
            style="-fx-background-color:#243224;-fx-padding:15;-fx-background-radius:8;">
        <Label text="บันทึกการตรวจสอบต้นปาล์ม"
               style="-fx-text-fill:#4CAF50;-fx-font-weight:bold;-fx-font-size:14px;"/>
        <Label text="สวนปาล์ม:" style="-fx-text-fill:#ccddcc;"/>
        <ComboBox fx:id="cbPlantation" prefWidth="260" promptText="เลือกสวน"/>
        <Label text="เกรดสภาพต้นปาล์ม:" style="-fx-text-fill:#ccddcc;"/>
        <ComboBox fx:id="cbGrade" prefWidth="260" promptText="เลือกเกรด"/>
        <Label text="รายละเอียด / ข้อบกพร่อง:" style="-fx-text-fill:#ccddcc;"/>
        <TextArea fx:id="txtDefect" promptText="บรรยายสภาพต้นปาล์ม" prefHeight="80"
                  style="-fx-background-color:#2d3e2d;-fx-text-fill:white;"/>
        <Label text="ผู้ตรวจ:" style="-fx-text-fill:#ccddcc;"/>
        <TextField fx:id="txtInspector" promptText="ชื่อผู้ตรวจสอบ"
                   style="-fx-background-color:#2d3e2d;-fx-text-fill:white;"/>
        <Label text="วันที่ตรวจ:" style="-fx-text-fill:#ccddcc;"/>
        <DatePicker fx:id="dpInspectDate" prefWidth="260"/>
        <Button text="บันทึกผลตรวจ" onAction="#handleSave" maxWidth="Infinity"
                style="-fx-background-color:#4CAF50;-fx-text-fill:white;
                       -fx-cursor:hand;-fx-padding:8;-fx-background-radius:5;"/>
        <Label fx:id="lblMsg" text="" style="-fx-font-size:12px;" wrapText="true"/>
        <Button text="รีเฟรช" onAction="#handleRefresh"
                style="-fx-background-color:#2196F3;-fx-text-fill:white;-fx-cursor:hand;"/>
      </VBox>
      <TableView fx:id="tableInspection" HBox.hgrow="ALWAYS"
                 style="-fx-background-color:#243224;-fx-control-inner-background:#243224;">
        <columns>
          <TableColumn fx:id="colQiId"        text="ID"         prefWidth="55"/>
          <TableColumn fx:id="colQiPlantation" text="สวนปาล์ม" prefWidth="130"/>
          <TableColumn fx:id="colQiGrade"     text="เกรด"       prefWidth="70"/>
          <TableColumn fx:id="colQiDefect"    text="รายละเอียด"  prefWidth="220"/>
          <TableColumn fx:id="colQiDate"      text="วันที่ตรวจ"  prefWidth="120"/>
          <TableColumn fx:id="colQiInspector" text="ผู้ตรวจ"    prefWidth="140"/>
        </columns>
        <placeholder><Label text="ไม่มีข้อมูล" style="-fx-text-fill:#88aa88;"/></placeholder>
      </TableView>
    </HBox>
  </center>
</BorderPane>
