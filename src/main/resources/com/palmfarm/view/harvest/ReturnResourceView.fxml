<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane style="-fx-background-color:#1a2a1a;" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.palmfarm.controller.harvest.ReturnResourceViewController">
  <center>
    <VBox spacing="8" style="-fx-padding:15;">
      <HBox alignment="CENTER_LEFT" spacing="8">
        <Label style="-fx-text-fill:#aaccaa;-fx-font-weight:bold;" text="งานที่ได้รับมอบหมาย:" />
        <Button onAction="#handleRefresh" style="-fx-background-color:#2196F3;-fx-text-fill:white;-fx-cursor:hand;-fx-padding:5 12;" text="รีเฟรช" />
      </HBox>
      <TableView fx:id="tableTask" prefHeight="260" style="-fx-background-color:#243224;-fx-control-inner-background:#243224;" VBox.vgrow="ALWAYS">
        <columns>
          <TableColumn fx:id="colTaskId" prefWidth="55" text="ID" />
          <TableColumn fx:id="colTaskDesc" prefWidth="240" text="คำอธิบาย" />
          <TableColumn fx:id="colTaskPlantation" prefWidth="120" text="สวนปาล์ม" />
          <TableColumn fx:id="colTaskStatus" prefWidth="140" text="สถานะงาน" />
          <TableColumn fx:id="colTaskOrdered" prefWidth="140" text="สถานะมอบหมาย" />
          <TableColumn fx:id="colTaskDeadline" prefWidth="110" text="กำหนดส่ง" />
        </columns>
        <placeholder><Label style="-fx-text-fill:#88aa88;" text="ไม่มีงาน" /></placeholder>
            <columnResizePolicy>
               <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
      </TableView>
      <Label style="-fx-text-fill:#aaccaa;-fx-font-weight:bold;" text="ทรัพยากรที่เบิกยืม:" />
      <TableView fx:id="tableReservation" prefHeight="160" style="-fx-background-color:#243224;-fx-control-inner-background:#243224;" VBox.vgrow="ALWAYS">
        <columns>
          <TableColumn fx:id="colRlName" prefWidth="220" text="ทรัพยากร" />
          <TableColumn fx:id="colRlType" prefWidth="130" text="ประเภท" />
          <TableColumn fx:id="colRlReturn" prefWidth="130" text="สถานะการคืน" />
        </columns>
        <placeholder><Label style="-fx-text-fill:#88aa88;" text="เลือก Task เพื่อดูทรัพยากร" /></placeholder>
            <columnResizePolicy>
               <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
      </TableView>
      <HBox alignment="CENTER_LEFT" spacing="10">
        <Button fx:id="btnComplete" disable="true" onAction="#handleCompleteTask" style="-fx-background-color:#FF9800;-fx-text-fill:white;                        -fx-font-size:13px;-fx-cursor:hand;-fx-padding:8 16;-fx-background-radius:5;" text="ยืนยันเสร็จสิ้นและคืนทรัพยากร" />
        <Label fx:id="lblMsg" style="-fx-font-size:12px;" text="" wrapText="true" />
      </HBox>
    </VBox>
  </center>
</BorderPane>
