<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane style="-fx-background-color:#1a2a1a;" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.palmfarm.controller.harvest.HarvestTaskViewController">
  <center>
    <VBox spacing="8" style="-fx-padding:15;">
      <HBox spacing="8">
        <Button onAction="#handleMarkUsed" style="-fx-background-color:#607D8B;-fx-text-fill:white;-fx-cursor:hand;" text="บันทึกการใช้ทรัพยากร" />
        <Button fx:id="btnComplete" disable="true" onAction="#handleCompleteTask" style="-fx-background-color:#4CAF50;-fx-text-fill:white;-fx-cursor:hand;" text="งานเสร็จสิ้น + คืนทรัพยากร" />
      </HBox>
      <Label style="-fx-text-fill:#aaccaa;-fx-font-weight:bold;" text="ใบสั่งงาน:" />
      <TableView fx:id="tableTask" prefHeight="280" style="-fx-background-color:#243224;-fx-control-inner-background:#243224;" VBox.vgrow="ALWAYS">
        <columns>
          <TableColumn fx:id="colTaskId" prefWidth="55" text="ID" />
          <TableColumn fx:id="colTaskDesc" prefWidth="230" text="คำอธิบาย" />
          <TableColumn fx:id="colTaskPlantation" prefWidth="120" text="สวนปาล์ม" />
          <TableColumn fx:id="colTaskStatus" prefWidth="140" text="สถานะงาน" />
          <TableColumn fx:id="colTaskOrdered" prefWidth="140" text="สถานะมอบหมาย" />
          <TableColumn fx:id="colTaskDeadline" prefWidth="110" text="กำหนดส่ง" />
        </columns>
        <placeholder><Label style="-fx-text-fill:#88aa88;" text="ไม่มีงาน" /></placeholder>
            <columnResizePolicy>
               <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
      </TableView>
      <Label style="-fx-text-fill:#aaccaa;-fx-font-weight:bold;" text="ทรัพยากรสำหรับงานที่เลือก:" />
      <TableView fx:id="tableReservation" prefHeight="170" style="-fx-background-color:#243224;-fx-control-inner-background:#243224;" VBox.vgrow="ALWAYS">
        <columns>
          <TableColumn fx:id="colRlName" prefWidth="220" text="ทรัพยากร" />
          <TableColumn fx:id="colRlType" prefWidth="130" text="ประเภท" />
          <TableColumn fx:id="colRlUsed" prefWidth="130" text="สถานะ" />
        </columns>
        <placeholder><Label style="-fx-text-fill:#88aa88;" text="เลือก Task เพื่อดูทรัพยากร" /></placeholder>
            <columnResizePolicy>
               <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
      </TableView>
      <Label fx:id="lblMsg" style="-fx-font-size:12px;" text="" wrapText="true" />
    </VBox>
  </center>
</BorderPane>
