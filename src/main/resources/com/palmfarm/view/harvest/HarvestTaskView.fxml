<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.palmfarm.controller.harvest.HarvestTaskViewController"
            style="-fx-background-color:#1a2a1a;">
  <center>
    <VBox spacing="8" style="-fx-padding:15;">
      <HBox spacing="8">
        <Button text="รีเฟรช" onAction="#handleRefresh"
                style="-fx-background-color:#2196F3;-fx-text-fill:white;-fx-cursor:hand;"/>
        <Button text="บันทึกการใช้ทรัพยากร" onAction="#handleMarkUsed"
                style="-fx-background-color:#607D8B;-fx-text-fill:white;-fx-cursor:hand;"/>
        <Button fx:id="btnComplete" text="งานเสร็จสิ้น + คืนทรัพยากร"
                onAction="#handleCompleteTask" disable="true"
                style="-fx-background-color:#4CAF50;-fx-text-fill:white;-fx-cursor:hand;"/>
      </HBox>
      <Label text="ใบสั่งงาน:" style="-fx-text-fill:#aaccaa;-fx-font-weight:bold;"/>
      <TableView fx:id="tableTask" VBox.vgrow="ALWAYS" prefHeight="280"
                 style="-fx-background-color:#243224;-fx-control-inner-background:#243224;">
        <columns>
          <TableColumn fx:id="colTaskId"          text="ID"            prefWidth="55"/>
          <TableColumn fx:id="colTaskDesc"         text="คำอธิบาย"     prefWidth="230"/>
          <TableColumn fx:id="colTaskPlantation"   text="สวนปาล์ม"    prefWidth="120"/>
          <TableColumn fx:id="colTaskStatus"       text="สถานะงาน"    prefWidth="140"/>
          <TableColumn fx:id="colTaskOrdered"      text="สถานะมอบหมาย" prefWidth="140"/>
          <TableColumn fx:id="colTaskDeadline"     text="กำหนดส่ง"    prefWidth="110"/>
        </columns>
        <placeholder><Label text="ไม่มีงาน" style="-fx-text-fill:#88aa88;"/></placeholder>
      </TableView>
      <Label text="ทรัพยากรสำหรับงานที่เลือก:" style="-fx-text-fill:#aaccaa;-fx-font-weight:bold;"/>
      <TableView fx:id="tableReservation" VBox.vgrow="ALWAYS" prefHeight="170"
                 style="-fx-background-color:#243224;-fx-control-inner-background:#243224;">
        <columns>
          <TableColumn fx:id="colRlName" text="ทรัพยากร" prefWidth="220"/>
          <TableColumn fx:id="colRlType" text="ประเภท"   prefWidth="130"/>
          <TableColumn fx:id="colRlUsed" text="สถานะ"    prefWidth="130"/>
        </columns>
        <placeholder><Label text="เลือก Task เพื่อดูทรัพยากร" style="-fx-text-fill:#88aa88;"/></placeholder>
      </TableView>
      <Label fx:id="lblMsg" text="" style="-fx-font-size:12px;" wrapText="true"/>
    </VBox>
  </center>
</BorderPane>
