<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="20" style="-fx-background-color: #1a2a1a; -fx-padding: 40;" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.palmfarm.controller.LoginViewController">

    <Label style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #4CAF50;" text="ระบบจัดการสวนปาล์ม" />

    <Label style="-fx-font-size: 13px; -fx-text-fill: #88aa88;" text="Palm Farm Management System" />

    <VBox maxWidth="320" spacing="12" style="-fx-background-color: #243224; -fx-padding: 30; -fx-background-radius: 10;">

        <Label style="-fx-text-fill: #ccddcc; -fx-font-size: 13px;" text="ชื่อผู้ใช้" />
        <TextField fx:id="txtUsername" promptText="กรอกชื่อผู้ใช้" style="-fx-background-color: #2d3e2d; -fx-text-fill: white; -fx-prompt-text-fill: #668866; -fx-border-color: #4a6a4a; -fx-border-radius: 5; -fx-background-radius: 5; -fx-padding: 8;" />

        <Label style="-fx-text-fill: #ccddcc; -fx-font-size: 13px;" text="รหัสผ่าน" />
        <PasswordField fx:id="txtPassword" promptText="กรอกรหัสผ่าน" style="-fx-background-color: #2d3e2d; -fx-text-fill: white; -fx-prompt-text-fill: #668866; -fx-border-color: #4a6a4a; -fx-border-radius: 5; -fx-background-radius: 5; -fx-padding: 8;" />

        <Label fx:id="lblError" style="-fx-text-fill: #ff6b6b; -fx-font-size: 12px;" text="" wrapText="true" />

        <Button fx:id="btnLogin" maxWidth="Infinity" onAction="#handleLogin" style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 10; -fx-background-radius: 5; -fx-cursor: hand;" text="เข้าสู่ระบบ" />
    </VBox>

    <Label style="-fx-text-fill: #446644; -fx-font-size: 11px;" text="version 1.0  Palm Farm System" />
</VBox>
