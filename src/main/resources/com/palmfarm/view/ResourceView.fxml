<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane style="-fx-background-color: #1a2a1a;" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.palmfarm.controller.ResourceViewController">

    <!-- MAIN CONTENT -->
    <center>
        <TabPane fx:id="tabPane" style="-fx-background-color: #1a2a1a; -fx-tab-min-width: 160px;" tabClosingPolicy="UNAVAILABLE">

            <!-- TAB 1: จัดการ Task -->
            <Tab text="สร้างใบสั่งงาน">
                <VBox spacing="10" style="-fx-padding: 15;">
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label style="-fx-text-fill: #ccddcc;" text="คำอธิบาย:" />
                        <TextField fx:id="txtTaskDescription" prefWidth="250" promptText="รายละเอียดงาน" style="-fx-background-color: #2d3e2d; -fx-text-fill: white;" />
                        <Label style="-fx-text-fill: #ccddcc;" text="ฝ่าย:" />
                        <ComboBox fx:id="cbTaskDept" prefWidth="160" promptText="เลือกฝ่าย" />
                        <Label style="-fx-text-fill: #ccddcc;" text="กำหนดส่ง:" />
                        <DatePicker fx:id="dpDeadline" prefWidth="160" />
                        <Button onAction="#handleCreateTask" style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-cursor: hand;" text="+ สร้าง Task" />
                        <Button onAction="#handleRefreshTask" style="-fx-background-color: #2196F3; -fx-text-fill: white; -fx-cursor: hand;" text="รีเฟรช" />
                    </HBox>
                    <Label fx:id="lblTaskMsg" style="-fx-text-fill: #88ff88;" text="" />
                    <TableView fx:id="tableTask" style="-fx-background-color: #243224; -fx-control-inner-background: #243224;" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="colTaskId" prefWidth="60" text="ID" />
                            <TableColumn fx:id="colTaskDesc" prefWidth="280" text="คำอธิบาย" />
                            <TableColumn fx:id="colTaskDept" prefWidth="140" text="ฝ่าย" />
                            <TableColumn fx:id="colTaskStatus" prefWidth="140" text="สถานะ" />
                            <TableColumn fx:id="colTaskDeadline" prefWidth="140" text="กำหนดส่ง" />
                        </columns>
                        <placeholder><Label style="-fx-text-fill: #88aa88;" text="ไม่มีข้อมูล" /></placeholder>
                    </TableView>
                </VBox>
            </Tab>

            <!-- TAB 2: จัดการ Resource -->
            <Tab text="จัดการทรัพยากร">
                <VBox spacing="10" style="-fx-padding: 15;">
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label style="-fx-text-fill: #ccddcc;" text="ชื่อ:" />
                        <TextField fx:id="txtResName" prefWidth="200" promptText="ชื่อทรัพยากร" style="-fx-background-color: #2d3e2d; -fx-text-fill: white;" />
                        <Label style="-fx-text-fill: #ccddcc;" text="ประเภท:" />
                        <ComboBox fx:id="cbResType" prefWidth="160" promptText="ประเภท" />
                        <Button onAction="#handleAddResource" style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-cursor: hand;" text="+ เพิ่มทรัพยากร" />
                        <Button onAction="#handleRefreshResource" style="-fx-background-color: #2196F3; -fx-text-fill: white; -fx-cursor: hand;" text="รีเฟรช" />
                    </HBox>
                    <Label fx:id="lblResMsg" style="-fx-text-fill: #88ff88;" text="" />
                    <TableView fx:id="tableResource" style="-fx-background-color: #243224; -fx-control-inner-background: #243224;" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="colResId" prefWidth="60" text="ID" />
                            <TableColumn fx:id="colResName" prefWidth="250" text="ชื่อ" />
                            <TableColumn fx:id="colResType" prefWidth="150" text="ประเภท" />
                            <TableColumn fx:id="colResStatus" prefWidth="150" text="สถานะ" />
                        </columns>
                        <placeholder><Label style="-fx-text-fill: #88aa88;" text="ไม่มีข้อมูล" /></placeholder>
                    </TableView>
                </VBox>
            </Tab>

            <!-- TAB 3: จัดสรร Resource → Task -->
            <Tab text="จัดสรรทรัพยากร">
                <VBox spacing="10" style="-fx-padding: 15;">
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label style="-fx-text-fill: #ccddcc;" text="Task:" />
                        <ComboBox fx:id="cbAssignTask" prefWidth="280" />
                        <Label style="-fx-text-fill: #ccddcc;" text="ทรัพยากร:" />
                        <ComboBox fx:id="cbAssignResource" prefWidth="220" />
                        <Label style="-fx-text-fill: #ccddcc;" text="วันที่:" />
                        <DatePicker fx:id="dpAssignDate" prefWidth="160" />
                        <Button onAction="#handleAssignResource" style="-fx-background-color: #FF9800; -fx-text-fill: white; -fx-cursor: hand;" text="จัดสรร" />
                        <Button onAction="#handleLoadReservations" style="-fx-background-color: #2196F3; -fx-text-fill: white; -fx-cursor: hand;" text="ดูรายการ" />
                    </HBox>
                    <Label fx:id="lblAssignMsg" style="-fx-text-fill: #88ff88;" text="" />
                    <Label style="-fx-text-fill: #aaccaa; -fx-font-weight: bold;" text="รายการทรัพยากรที่จัดสรรให้ Task:" />
                    <TableView fx:id="tableReservation" style="-fx-background-color: #243224; -fx-control-inner-background: #243224;" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="colRlResource" prefWidth="200" text="ทรัพยากร" />
                            <TableColumn fx:id="colRlType" prefWidth="150" text="ประเภท" />
                            <TableColumn fx:id="colRlDate" prefWidth="140" text="วันที่" />
                            <TableColumn fx:id="colRlStatus" prefWidth="150" text="สถานะ" />
                        </columns>
                        <placeholder><Label style="-fx-text-fill: #88aa88;" text="เลือก Task แล้วกด 'ดูรายการ'" /></placeholder>
                    </TableView>
                </VBox>
            </Tab>

        </TabPane>
    </center>
</BorderPane>
