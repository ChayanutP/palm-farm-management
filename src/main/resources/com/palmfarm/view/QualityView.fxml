<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.palmfarm.controller.QualityViewController"
            style="-fx-background-color: #1a2a1a;">
    <center>
        <TabPane fx:id="tabPane" tabClosingPolicy="UNAVAILABLE"
                 style="-fx-background-color: #1a2a1a; -fx-tab-min-width: 200px;">

            <!-- Tab: รายการงาน -->
            <Tab text="รายการงานตรวจสอบ">
                <VBox spacing="10" style="-fx-padding: 15;">
                    <HBox spacing="8"><Button text="รีเฟรช" onAction="#handleRefresh"
                            style="-fx-background-color: #2196F3; -fx-text-fill: white; -fx-cursor: hand;"/></HBox>
                    <TableView fx:id="tableTask" VBox.vgrow="ALWAYS"
                               style="-fx-background-color: #243224; -fx-control-inner-background: #243224;">
                        <columns>
                            <TableColumn fx:id="colTaskId"       text="ID"       prefWidth="60"/>
                            <TableColumn fx:id="colTaskDesc"     text="คำอธิบาย"   prefWidth="280"/>
                            <TableColumn fx:id="colTaskStatus"   text="สถานะ"     prefWidth="140"/>
                            <TableColumn fx:id="colTaskDeadline" text="กำหนดส่ง"  prefWidth="140"/>
                        </columns>
                        <placeholder><Label text="ไม่มีงาน" style="-fx-text-fill: #88aa88;"/></placeholder>
                    </TableView>
                </VBox>
            </Tab>

            <!-- Tab: บันทึกผลตรวจ -->
            <Tab text="บันทึกผลตรวจสอบคุณภาพ">
                <HBox spacing="15" style="-fx-padding: 15;">
                    <!-- Form -->
                    <VBox spacing="8" prefWidth="300" style="-fx-background-color: #243224; -fx-padding: 15; -fx-background-radius: 8;">
                        <Label text="บันทึกผลตรวจ" style="-fx-text-fill: #4CAF50; -fx-font-weight: bold; -fx-font-size: 14px;"/>
                        <Label text="Task:" style="-fx-text-fill: #ccddcc;"/>
                        <ComboBox fx:id="cbInspectTask" prefWidth="260"/>
                        <Label text="เกรดคุณภาพ:" style="-fx-text-fill: #ccddcc;"/>
                        <ComboBox fx:id="cbQualityGrade" prefWidth="260"/>
                        <Label text="รายละเอียดข้อบกพร่อง:" style="-fx-text-fill: #ccddcc;"/>
                        <TextArea fx:id="txtDefect" promptText="บรรยายข้อบกพร่อง (ถ้ามี)" prefHeight="80"
                                  style="-fx-background-color: #2d3e2d; -fx-text-fill: white;"/>
                        <Label text="ปริมาณ (กก.):" style="-fx-text-fill: #ccddcc;"/>
                        <TextField fx:id="txtAmount" promptText="ปริมาณปาล์ม"
                                   style="-fx-background-color: #2d3e2d; -fx-text-fill: white;"/>
                        <Label text="ผู้ตรวจ:" style="-fx-text-fill: #ccddcc;"/>
                        <TextField fx:id="txtInspector" promptText="ชื่อผู้ตรวจสอบ"
                                   style="-fx-background-color: #2d3e2d; -fx-text-fill: white;"/>
                        <Label text="วันที่ตรวจ:" style="-fx-text-fill: #ccddcc;"/>
                        <DatePicker fx:id="dpInspectDate" prefWidth="260"/>
                        <Button text="บันทึกผลตรวจ" onAction="#handleSaveInspection" maxWidth="Infinity"
                                style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-cursor: hand; -fx-padding: 8;"/>
                        <Label fx:id="lblQualityMsg" text="" style="-fx-text-fill: #88ff88;" wrapText="true"/>
                    </VBox>
                    <!-- Table -->
                    <TableView fx:id="tableInspection" HBox.hgrow="ALWAYS"
                               style="-fx-background-color: #243224; -fx-control-inner-background: #243224;">
                        <columns>
                            <TableColumn fx:id="colQiId"       text="ID"        prefWidth="60"/>
                            <TableColumn fx:id="colQiQuality"  text="เกรด"       prefWidth="80"/>
                            <TableColumn fx:id="colQiDefect"   text="ข้อบกพร่อง"  prefWidth="200"/>
                            <TableColumn fx:id="colQiDate"     text="วันที่ตรวจ"  prefWidth="120"/>
                            <TableColumn fx:id="colQiAmount"   text="ปริมาณ"     prefWidth="100"/>
                            <TableColumn fx:id="colQiInspector" text="ผู้ตรวจ"   prefWidth="140"/>
                        </columns>
                        <placeholder><Label text="ไม่มีข้อมูล" style="-fx-text-fill: #88aa88;"/></placeholder>
                    </TableView>
                </HBox>
            </Tab>

        </TabPane>
    </center>
</BorderPane>
