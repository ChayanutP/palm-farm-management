<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.palmfarm.controller.accounting.StoreBillViewController"
            style="-fx-background-color:#1a2a1a;">
  <center>
    <HBox spacing="15" style="-fx-padding:15;">
      <VBox spacing="10" HBox.hgrow="ALWAYS">
        <HBox spacing="8">
          <Button text="อัปโหลดรูปบิล" onAction="#handleUpload"
                  style="-fx-background-color:#2196F3;-fx-text-fill:white;-fx-cursor:hand;"/>
          <Button text="จัดเก็บบิลที่เลือก" onAction="#handleStore"
                  style="-fx-background-color:#4CAF50;-fx-text-fill:white;-fx-cursor:hand;"/>
          <Button text="" onAction="#handleRefresh"
                  style="-fx-background-color:#607D8B;-fx-text-fill:white;-fx-cursor:hand;"/>
        </HBox>
        <Label fx:id="lblMsg" text="" style="-fx-text-fill:#88ff88;"/>
        <TableView fx:id="tableUnstored" VBox.vgrow="ALWAYS"
                   style="-fx-background-color:#243224;-fx-control-inner-background:#243224;">
          <columns>
            <TableColumn fx:id="colBillId"   text="ID"        prefWidth="70"/>
            <TableColumn fx:id="colUploaded" text="อัปโหลดเมื่อ" prefWidth="220"/>
            <TableColumn fx:id="colStored"   text="จัดเก็บ"    prefWidth="100"/>
          </columns>
          <placeholder><Label text="ไม่มีบิลรอจัดเก็บ" style="-fx-text-fill:#88aa88;"/></placeholder>
        </TableView>
      </VBox>
      <VBox spacing="8" prefWidth="300" style="-fx-background-color:#243224;-fx-padding:10;-fx-background-radius:8;">
        <Label text="ตัวอย่างรูปบิล" style="-fx-text-fill:#aaccaa;-fx-font-weight:bold;"/>
        <ImageView fx:id="imgPreview" fitWidth="280" fitHeight="380" preserveRatio="true"/>
      </VBox>
    </HBox>
  </center>
</BorderPane>
