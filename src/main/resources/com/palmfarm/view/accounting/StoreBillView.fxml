<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane style="-fx-background-color:#1a2a1a;" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.palmfarm.controller.accounting.StoreBillViewController">
  <center>
    <HBox spacing="15" style="-fx-padding:15;">
      <VBox spacing="10" HBox.hgrow="ALWAYS">
        <HBox spacing="8">
          <Button onAction="#handleUpload" style="-fx-background-color: orange; -fx-text-fill: white; -fx-cursor: hand; -fx-padding: 5 12;" text="อัปโหลดรูปบิล" />
          <Button onAction="#handleStore" style="-fx-background-color:#4CAF50;-fx-text-fill:white;-fx-cursor:hand;" text="จัดเก็บบิลที่เลือก" />
        </HBox>
        <Label fx:id="lblMsg" style="-fx-text-fill:#88ff88;" text="" />
        <TableView fx:id="tableUnstored" style="-fx-background-color:#243224;-fx-control-inner-background:#243224;" VBox.vgrow="ALWAYS">
          <columns>
            <TableColumn fx:id="colBillId" prefWidth="70" text="ID" />
            <TableColumn fx:id="colUploaded" prefWidth="220" text="อัปโหลดเมื่อ" />
          </columns>
          <placeholder><Label style="-fx-text-fill:#88aa88;" text="ไม่มีบิลรอจัดเก็บ" /></placeholder>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
        </TableView>
      </VBox>
      <VBox prefWidth="300" spacing="8" style="-fx-background-color:#243224;-fx-padding:10;-fx-background-radius:8;">
        <Label style="-fx-text-fill:#aaccaa;-fx-font-weight:bold;" text="ตัวอย่างรูปบิล" />
        <ImageView fx:id="imgPreview" fitHeight="544.0" fitWidth="482.0" preserveRatio="true" />
      </VBox>
    </HBox>
  </center>
</BorderPane>
