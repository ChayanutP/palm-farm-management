<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane style="-fx-background-color:#1a2a1a;" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.palmfarm.controller.accounting.RecordBillViewController">
  <center>
    <HBox spacing="15" style="-fx-padding:15;">
      <VBox spacing="8" HBox.hgrow="ALWAYS">
        <HBox spacing="8"><Button onAction="#handleExport" style="-fx-background-color: #795548; -fx-text-fill: white; -fx-cursor: hand; -fx-padding: 5 12;" text="Export รายงาน" />
        <Button onAction="#handleRefresh" style="-fx-background-color: #2196F3; -fx-text-fill: white; -fx-cursor: hand;" text="รีเฟรช" /></HBox>
        <TableView fx:id="tableStored" prefWidth="602.0" style="-fx-background-color:#243224;-fx-control-inner-background:#243224;" VBox.vgrow="ALWAYS">
          <columns>
            <TableColumn fx:id="colBillId" prefWidth="60" text="ID" />
            <TableColumn fx:id="colNumber" prefWidth="140" text="เลขที่บิล" />
            <TableColumn fx:id="colDate" prefWidth="120" text="วันที่ขาย" />
            <TableColumn fx:id="colBuyer" prefWidth="160" text="ผู้รับซื้อ" />
            <TableColumn fx:id="colTotal" prefWidth="120" text="ยอดรวม (บาท)" />
          </columns>
          <placeholder><Label style="-fx-text-fill:#88aa88;" text="ไม่มีบิล" /></placeholder>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
        </TableView>
        <Label style="-fx-text-fill:#aaccaa;" text="รูปบิล:" />
        <ImageView fx:id="imgBill" fitHeight="497.0" fitWidth="445.0" preserveRatio="true" />
      </VBox>
      <VBox prefWidth="290" spacing="8" style="-fx-background-color:#243224;-fx-padding:15;-fx-background-radius:8;">
        <Label style="-fx-text-fill:#4CAF50;-fx-font-weight:bold;-fx-font-size:14px;" text="กรอกข้อมูลบิล" />
        <Label style="-fx-text-fill:#ccddcc;" text="เลขที่บิล:" />
        <TextField fx:id="txtBillNumber" style="-fx-background-color:#2d3e2d;-fx-text-fill:white;" />
        <Label style="-fx-text-fill:#ccddcc;" text="วันที่ขาย:" />
        <DatePicker fx:id="dpSaleDate" prefWidth="260" />
        <Label style="-fx-text-fill:#ccddcc;" text="ผู้รับซื้อ:" />
        <TextField fx:id="txtBuyer" style="-fx-background-color:#2d3e2d;-fx-text-fill:white;" />
        <Label style="-fx-text-fill:#ccddcc;" text="ปริมาณ (กก.):" />
        <TextField fx:id="txtQuantity" style="-fx-background-color:#2d3e2d;-fx-text-fill:white;" />
        <Label style="-fx-text-fill:#ccddcc;" text="ราคา/หน่วย (บาท):" />
        <TextField fx:id="txtPriceUnit" style="-fx-background-color:#2d3e2d;-fx-text-fill:white;" />
        <Label fx:id="lblTotalCalc" style="-fx-text-fill:#FFD700;-fx-font-size:14px;-fx-font-weight:bold;" text="รวม: " />
        <Button maxWidth="Infinity" onAction="#handleSave" style="-fx-background-color:#4CAF50;-fx-text-fill:white;-fx-cursor:hand;-fx-padding:8;" text="บันทึกข้อมูลบิล" />
        <Label fx:id="lblMsg" style="-fx-text-fill:#88ff88;" text="" wrapText="true" />
      </VBox>
    </HBox>
  </center>
</BorderPane>
